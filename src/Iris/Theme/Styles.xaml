<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Palette ============================ -->
    <Color x:Key="BackgroundColor">#FF07070A</Color>
    <Color x:Key="AccentColor">#FF4C8DFF</Color>

    <SolidColorBrush x:Key="BackgroundBrush"    Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#FFF3F4F6" />
    <!-- These greys were picked against Iris's own near-black background, but most of
         them are read over video, where the scrim only gets the background so far down.
         Both are lifted well clear of the old values; the hierarchy still reads, and
         ChromeTextShadow below does the rest of the work over bright frames. -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFC5CBD5" />
    <SolidColorBrush x:Key="TextTertiaryBrush"  Color="#FF949BA7" />
    <SolidColorBrush x:Key="TrackBrush"         Color="#38FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush"         Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="PressedBrush"       Color="#0DFFFFFF" />

    <!-- No fixed colour is safe against arbitrary video, so chrome text carries a tight
         dark halo as well. This is what keeps the readout legible over a white sky
         without having to black out half the frame with scrim. -->
    <DropShadowEffect x:Key="ChromeTextShadow"
                      Color="#FF000000" BlurRadius="5" ShadowDepth="0" Opacity="0.9" />

    <!-- Scrims keep the controls legible over bright video without dimming the frame. -->
    <LinearGradientBrush x:Key="BottomScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.0" />
        <GradientStop Color="#59000000" Offset="0.45" />
        <GradientStop Color="#D9000000" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Trim mode stacks another row above the timeline, so the ordinary scrim is still
         nearly transparent where the header lands. This one ramps up much sooner. -->
    <LinearGradientBrush x:Key="TrimScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.0" />
        <GradientStop Color="#B3000000" Offset="0.22" />
        <GradientStop Color="#E6000000" Offset="0.45" />
        <GradientStop Color="#F2000000" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TopScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A6000000" Offset="0.0" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ============================ Icons ============================ -->
    <!-- Filled -->
    <PathGeometry x:Key="PlayGeometry"    Figures="M7.14,3.02 L20.74,12 L7.14,20.98 Z" />
    <PathGeometry x:Key="PauseGeometry"   Figures="M5.93,3.26 H10.3 V20.74 H5.93 Z M13.7,3.26 H18.07 V20.74 H13.7 Z" />
    <PathGeometry x:Key="SpeakerGeometry" Figures="M1.07,8.36 L6.17,8.36 L12,2.77 L12,21.23 L6.17,15.64 L1.07,15.64 Z" />

    <!-- Stroked -->
    <PathGeometry x:Key="WavesHighGeometry" Figures="M15.76,8.72 A4.49,4.49 0 0 1 15.76,15.28 M19.16,5.44 A9.35,9.35 0 0 1 19.16,18.56" />
    <PathGeometry x:Key="WavesLowGeometry"  Figures="M15.76,8.72 A4.49,4.49 0 0 1 15.76,15.28" />
    <PathGeometry x:Key="MuteGeometry"      Figures="M16.13,8.84 L22.44,15.16 M22.44,8.84 L16.13,15.16" />
    <PathGeometry x:Key="EnterFullGeometry" Figures="M2.53,8.84 V2.53 H8.84 M15.16,2.53 H21.47 V8.84 M21.47,15.16 V21.47 H15.16 M8.84,21.47 H2.53 V15.16" />
    <PathGeometry x:Key="ExitFullGeometry"  Figures="M8.84,2.53 V8.84 H2.53 M21.47,8.84 H15.16 V2.53 M15.16,21.47 V15.16 H21.47 M2.53,15.16 H8.84 V21.47" />
    <PathGeometry x:Key="OpenGeometry"      Figures="M1.8,19.41 V5.32 A1.46,1.46 0 0 1 3.26,3.87 H8.96 L11.64,7.02 H20.74 A1.46,1.46 0 0 1 22.2,8.48 V19.41 A1.46,1.46 0 0 1 20.74,20.86 H3.26 A1.46,1.46 0 0 1 1.8,19.41 Z" />
    <!-- Skip arrows. Open at the bottom left / right so the seconds count can sit inside
         the ring; radius 7.8 leaves a ~14px hole, which is what "10" needs to clear the
         stroke, and matches the visual weight of the other 24px icons. -->
    <PathGeometry x:Key="BackRingGeometry" Figures="M7.26,3.8 A9.47,9.47 0 1 0 16.74,3.8" />
    <PathGeometry x:Key="FwdRingGeometry"  Figures="M16.74,3.8 A9.47,9.47 0 1 1 7.26,3.8" />

    <!-- Filled heads, not stroked ones: a 1.7px chevron this small reads as a stray mark.
         They point straight out of the gap rather than along the rim, which is what makes
         them read as arrows instead of a thick stroke cap. Same 24x24 space as the rings,
         so the two paths stay registered. -->
    <PathGeometry x:Key="BackArrowGeometry" Figures="M2.4,3.8 L7.26,1.2 L7.26,6.4 Z" />
    <PathGeometry x:Key="FwdArrowGeometry"  Figures="M21.6,3.8 L16.74,1.2 L16.74,6.4 Z" />

    <!-- Chevrons for stepping through the folder. Mirrored about x=12 so the pair sits
         symmetrically either side of the file name. -->
    <PathGeometry x:Key="ChevronLeftGeometry"  Figures="M15.6,3.6 L7.2,12 L15.6,20.4" />
    <PathGeometry x:Key="ChevronRightGeometry" Figures="M8.4,3.6 L16.8,12 L8.4,20.4" />

    <!-- Scissors: two blades crossing above two finger rings, on the same 24 grid. -->
    <PathGeometry x:Key="TrimGeometry" Figures="M16.8,3.4 L6,16.2 M7.2,3.4 L18,16.2 M3.4,18.5 A2.6,2.6 0 1 0 8.6,18.5 A2.6,2.6 0 1 0 3.4,18.5 M15.4,18.5 A2.6,2.6 0 1 0 20.6,18.5 A2.6,2.6 0 1 0 15.4,18.5" />

    <!-- Logo mark for the empty state: a rounded frame around a play triangle. -->
    <!-- Sliders rather than a cog: the same stroke weight and round caps as the rest of
         the bar, where a cog's teeth would go muddy at 24px. The rails break either side
         of each handle so the line never reads as passing through it. -->
    <PathGeometry x:Key="SettingsGeometry" Figures="M3.4,7.6 H6.4 M11.6,7.6 H20.6 M6.4,7.6 A2.6,2.6 0 1 0 11.6,7.6 A2.6,2.6 0 1 0 6.4,7.6 M3.4,16.4 H12.4 M17.6,16.4 H20.6 M12.4,16.4 A2.6,2.6 0 1 0 17.6,16.4 A2.6,2.6 0 1 0 12.4,16.4" />

    <PathGeometry x:Key="LogoGeometry" Figures="M14,4 H50 A10,10 0 0 1 60,14 V50 A10,10 0 0 1 50,60 H14 A10,10 0 0 1 4,50 V14 A10,10 0 0 1 14,4 Z" />
    <PathGeometry x:Key="LogoPlayGeometry" Figures="M26,20 L44,32 L26,44 Z" />

    <!-- ============================ Icon button ============================ -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <!-- The row mixes 38px buttons with the 46px play button. Without this a
             horizontal StackPanel tops them out and the smaller glyphs sit high. -->
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="10" />
                        <ContentPresenter x:Name="Inner"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBrush}" />
                            <Setter TargetName="Inner" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.86" ScaleY="0.86" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Inner" Property="Opacity" Value="0.3" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
    </Style>

    <!-- Flanks the file name, so it is narrower and quieter than a transport button:
         at 38px in a row of 38px buttons these would read as transport controls. -->
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Opacity" Value="0.8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.25" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ Seek slider ============================ -->
    <!-- Resting 7px bar that thickens to 10px on hover; the knob only shows on hover/drag. -->
    <Style x:Key="SeekSlider" TargetType="Slider">
        <!-- Height is the click target, not the visible bar: a 28px band is easy to hit
             while the bar itself stays a 7px line. -->
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border x:Name="TrackBg" Height="7" VerticalAlignment="Center"
                                CornerRadius="3.5" Background="{StaticResource TrackBrush}" />
                        <Track x:Name="PART_Track">
                            <!-- The filled portion is the decrease button, so Track's own layout
                                 keeps it exactly in step with the thumb at every width. -->
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <!-- The negative margin carries the fill under the
                                                     thumb, which the Track otherwise leaves short.
                                                     It is the WHOLE thumb width, not half: Track
                                                     reserves the thumb at the right-hand end, so at
                                                     half the fill stopped 9px short and a finished
                                                     video looked a second shy of the end. At the
                                                     full width the fill ends exactly under the
                                                     thumb's right edge, which is the track's end. -->
                                                <Border CornerRadius="3.5" VerticalAlignment="Center"
                                                        Background="{StaticResource AccentBrush}"
                                                        Margin="0,0,-18,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Height" Value="7" />
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True"
                                                                             Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}">
                                                                    <Setter Property="Height" Value="10" />
                                                                    <Setter Property="CornerRadius" Value="5" />
                                                                </DataTrigger>
                                                                <!-- At zero that same margin would leave a
                                                                     stray dot at the start of the track. -->
                                                                <DataTrigger Value="0"
                                                                             Binding="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb" Width="18" Height="18" Focusable="False" Opacity="0">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Ellipse Width="18" Height="18" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="9" ShadowDepth="0"
                                                                          Color="#FF000000" Opacity="0.55" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TrackBg" Property="Height" Value="10" />
                            <Setter TargetName="TrackBg" Property="CornerRadius" Value="5" />
                            <Setter TargetName="PART_Thumb" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Volume slider ============================ -->
    <Style x:Key="VolumeSlider" TargetType="Slider">
        <Setter Property="Height" Value="20" />
        <Setter Property="Minimum" Value="0" />
        <!-- Above 100 the player amplifies, so the track runs to 200 with a mark at
             unity. Kept in sync with AppSettings.MaxVolume. -->
        <Setter Property="Maximum" Value="200" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4" VerticalAlignment="Center" CornerRadius="2"
                                Background="{StaticResource TrackBrush}" />

                        <!-- Unity, at the midpoint of a 0-200 track. Sits clear above the
                             rail so neither the fill nor the thumb can hide it. -->
                        <Border Width="2" Height="4" CornerRadius="1"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Background="{StaticResource TextTertiaryBrush}"
                                Opacity="0.7" />

                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4" CornerRadius="2"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,-6,0"
                                                        Background="{StaticResource TextPrimaryBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Value="0"
                                                                             Binding="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="12" Height="12" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Ellipse Width="12" Height="12" Fill="White" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Prose buttons ============================ -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="9"
                            Background="{StaticResource AccentBrush}"
                            Padding="20,10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet counterpart to PillButton for the non-committal choice -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="9"
                            Background="Transparent"
                            BorderBrush="{StaticResource TrackBrush}"
                            BorderThickness="1"
                            Padding="18,9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text-only, for destructive or tertiary actions that should not draw the eye -->
    <Style x:Key="QuietPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="9"
                            Background="#4D000000"
                            BorderBrush="#59FFFFFF"
                            BorderThickness="1"
                            Padding="20,10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#8CFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One choice out of a small set, shown as a row of adjoining buttons. The checked
         one carries the accent so the current state is readable without a tick or a
         dropdown to open. -->
    <Style x:Key="SegmentButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="8"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            Padding="16,8"
                            Margin="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The tray the segments sit in -->
    <Style x:Key="SegmentTray" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource TrackBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Compact readout that is also a button: the playback speed next to the clock -->
    <Style x:Key="SpeedPill" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="6"
                            Background="Transparent"
                            BorderBrush="{StaticResource TrackBrush}"
                            BorderThickness="1"
                            Padding="7,2"
                            MinWidth="36">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="2,6">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Trim ============================ -->
    <!-- Grab handles for the trim range. Deliberately chunky: they are the one control
         in the app you aim at precisely, and a thin handle on a 1900px timeline is a
         pixel hunt. -->
    <Style x:Key="TrimHandle" TargetType="Thumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- Transparent padding round the visible bar widens the hit target
                         without widening the mark on screen. -->
                    <Grid Background="#01000000">
                        <Border x:Name="Bar"
                                Width="12" Height="36"
                                CornerRadius="4"
                                Background="{StaticResource AccentBrush}" />
                        <Rectangle Width="2" Height="14" RadiusX="1" RadiusY="1"
                                   Fill="#E6FFFFFF" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#FF6BA3FF" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#FF8FBBFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrimLabel" TargetType="TextBlock">
        <Setter Property="Effect" Value="{StaticResource ChromeTextShadow}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================ Text ============================ -->
    <Style x:Key="TimeText" TargetType="TextBlock">
        <Setter Property="Effect" Value="{StaticResource ChromeTextShadow}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The seconds count sitting inside a skip button's circular arrow. Small enough
         that "10" clears the arc, nudged down to sit on the optical centre. -->
    <Style x:Key="SkipCount" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- Centring a text line centres its box, and the descender space below the
             digits then leaves them sitting a pixel low. Take it back. -->
        <Setter Property="Margin" Value="0,0,0,1.5" />
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="Effect" Value="{StaticResource ChromeTextShadow}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

</ResourceDictionary>

<Window x:Class="Iris.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:loc="clr-namespace:Iris.Localization"
        Title="Iris"
        Width="1120" Height="670"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True">

    <Window.Resources>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <vlc:VideoView x:Name="Video">
            <!-- VideoView renders its Content in a transparent overlay window that
                 tracks the video HWND, so all chrome lives inside here. -->
            <!-- Background is swapped in code between an opaque backdrop (no media, to
                 cover the unpainted video child window) and #01000000 (playing).
                 It must never be fully transparent: this is a layered window, and
                 Windows routes the mouse straight through any alpha-0 pixel of one,
                 which would kill hover, click and wheel over the picture. -->
            <Grid x:Name="OverlayRoot" Background="{StaticResource BackgroundBrush}" AllowDrop="True">

                <!-- ==================== Empty state ==================== -->
                <Grid x:Name="EmptyState">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="64" Height="64" HorizontalAlignment="Center" Opacity="0.95">
                            <Path Data="{StaticResource LogoGeometry}"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="3"
                                  Stretch="None" />
                            <Path Data="{StaticResource LogoPlayGeometry}"
                                  Fill="{StaticResource AccentBrush}" Stretch="None" />
                        </Grid>

                        <TextBlock Text="Iris"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="26" FontWeight="SemiBold" />

                        <TextBlock Text="{loc:Str StartDropHere}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="14" />

                        <Button x:Name="EmptyOpenButton"
                                Style="{StaticResource PillButton}"
                                Content="{loc:Str StartOpenVideo}"
                                HorizontalAlignment="Center"
                                Margin="0,26,0,0"
                                Click="OnOpenClick" />

                        <TextBlock Style="{StaticResource HintText}" Margin="0,34,0,0"
                                   Text="{loc:Str StartShortcuts}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,10,0,0">
                            <Button x:Name="AssociationLink"
                                    Style="{StaticResource LinkButton}"
                                    Content="{loc:Str StartDefaultPlayerLink}"
                                    Click="OnAssociationLinkClick" />

                            <TextBlock Text="·"
                                       Margin="10,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="12.5" />

                            <Button x:Name="SettingsLink"
                                    Style="{StaticResource LinkButton}"
                                    Content="{loc:Str StartSettingsLink}"
                                    Click="OnSettingsClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ==================== A file that will not play ==================== -->
                <Grid x:Name="ErrorState" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="420">
                        <Grid Width="52" Height="52" HorizontalAlignment="Center">
                            <Ellipse Stroke="{StaticResource TextTertiaryBrush}"
                                     StrokeThickness="2.4" />
                            <TextBlock Text="!"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="26" FontWeight="SemiBold" />
                        </Grid>

                        <TextBlock Text="{loc:Str ErrorHeading}"
                                   HorizontalAlignment="Center"
                                   Margin="0,18,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="19" FontWeight="SemiBold" />

                        <TextBlock x:Name="ErrorFileName"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Consolas, Cascadia Mono"
                                   FontSize="12.5" />

                        <TextBlock Text="{loc:Str ErrorBody}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   LineHeight="19"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="12.5" />

                        <Button Style="{StaticResource PillButton}"
                                Content="{loc:Str ErrorOpenAnother}"
                                HorizontalAlignment="Center"
                                Margin="0,24,0,0"
                                Click="OnOpenClick" />
                    </StackPanel>
                </Grid>

                <!-- ==================== Drop highlight ==================== -->
                <Border x:Name="DropHighlight"
                        Margin="10"
                        CornerRadius="12"
                        BorderThickness="2"
                        BorderBrush="{StaticResource AccentBrush}"
                        Background="#144C8DFF"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <TextBlock Text="{loc:Str DropToPlay}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="20" FontWeight="SemiBold" />
                </Border>

                <!-- ==================== Centre OSD flash ==================== -->
                <!-- Sized to its content rather than fixed: an icon keeps the square, but
                     a message like "Copied to clipboard" would otherwise spill straight out
                     of the rounded box, which is what longer OSD text used to do. -->
                <Border x:Name="Osd"
                        MinWidth="88" MinHeight="88"
                        Padding="20,0"
                        CornerRadius="18"
                        Background="#B3000000"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Opacity="0"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="OsdScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Grid>
                        <Path x:Name="OsdIcon"
                              Fill="{StaticResource TextPrimaryBrush}"
                              Stretch="Uniform" Width="40" Height="40"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="OsdText"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- ==================== Saving a clip ==================== -->
                <Border x:Name="ExportOverlay"
                        Background="#D9000000"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                        <TextBlock x:Name="ExportTitle"
                                   Style="{StaticResource TitleText}"
                                   FontSize="17"
                                   HorizontalAlignment="Center"
                                   Text="{loc:Str ExportSaving}" />
                        <TextBlock x:Name="ExportDetail"
                                   Style="{StaticResource HintText}"
                                   Margin="0,8,0,0"
                                   Text="" />

                        <Border Height="6" CornerRadius="3" Margin="0,22,0,0"
                                Background="{StaticResource TrackBrush}">
                            <Border x:Name="ExportProgressFill"
                                    Height="6" CornerRadius="3" Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}" />
                        </Border>

                        <Button x:Name="ExportCancelButton"
                                Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0"
                                Content="{loc:Str TrimCancel}"
                                Click="OnExportCancelClick" />
                    </StackPanel>
                </Border>

                <!-- ==================== Chrome (auto-hides) ==================== -->
                <Grid x:Name="Chrome" Opacity="1">

                    <!-- Title strip: only meaningful in fullscreen, where the caption is gone -->
                    <Grid x:Name="TopBar" VerticalAlignment="Top" Height="76" Visibility="Collapsed">
                        <Border Background="{StaticResource TopScrimBrush}" IsHitTestVisible="False" />
                        <TextBlock x:Name="TopTitle"
                                   Style="{StaticResource TitleText}"
                                   FontSize="15"
                                   Margin="22,20,22,0"
                                   VerticalAlignment="Top" />
                    </Grid>

                    <!-- Bottom control bar -->
                    <Grid x:Name="ControlBar" VerticalAlignment="Bottom">
                        <!-- Height is raised in code while trimming: the trim header adds
                             a row above the timeline, and without more scrim it would sit
                             on raw video and be unreadable. -->
                        <Border x:Name="BottomScrim"
                                Background="{StaticResource BottomScrimBrush}"
                                Height="130" VerticalAlignment="Bottom"
                                IsHitTestVisible="False" />

                        <StackPanel Margin="16,0,16,10">

                            <!-- Trim header: only up while trimming -->
                            <Grid x:Name="TrimHeader" Margin="6,0,6,8" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                                        <Path Data="{StaticResource TrimGeometry}"
                                              Stroke="{StaticResource AccentBrush}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stretch="None" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource TrimLabel}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               Margin="8,0,14,0"
                                               Text="{loc:Str TrimTitle}" />
                                    <TextBlock x:Name="TrimRangeLabel"
                                               Style="{StaticResource TrimLabel}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="TrimCancelButton"
                                            Style="{StaticResource QuietPillButton}"
                                            Content="{loc:Str TrimCancel}"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Click="OnTrimCancelClick" />
                                    <Button x:Name="TrimSaveButton"
                                            Style="{StaticResource PillButton}"
                                            Content="{loc:Str TrimSaveClip}"
                                            Click="OnTrimSaveClick" />
                                </StackPanel>
                            </Grid>

                            <!-- Seek row, with the hover time bubble sitting above it -->
                            <Grid Margin="6,0,6,2">
                                <Border x:Name="SeekPreview"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,28"
                                        Padding="8,4"
                                        CornerRadius="6"
                                        Background="#E6101014"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="SeekPreviewOffset" />
                                    </Border.RenderTransform>
                                    <TextBlock x:Name="SeekPreviewText"
                                               Style="{StaticResource TimeText}"
                                               FontSize="12" />
                                </Border>

                                <Slider x:Name="Seek"
                                        Style="{StaticResource SeekSlider}"
                                        Maximum="1000"
                                        Value="0" />

                                <!-- Takes the place of the timeline while trimming, so the
                                     two never compete. Laid out from code: a Canvas is the
                                     only panel that makes "put this handle exactly here"
                                     straightforward. -->
                                <Canvas x:Name="TrimCanvas"
                                        Height="40"
                                        Background="#01000000"
                                        Visibility="Collapsed"
                                        ClipToBounds="False">
                                    <Border x:Name="TrimTrack" Height="10" CornerRadius="5"
                                            Background="{StaticResource TrackBrush}" />
                                    <Border x:Name="TrimDimLeft" Height="10" CornerRadius="5,0,0,5"
                                            Background="#73000000" />
                                    <Border x:Name="TrimDimRight" Height="10" CornerRadius="0,5,5,0"
                                            Background="#73000000" />
                                    <Border x:Name="TrimSelection" Height="10"
                                            Background="{StaticResource AccentBrush}" />
                                    <Border x:Name="TrimPlayhead" Width="2" Height="26" CornerRadius="1"
                                            Background="{StaticResource TextPrimaryBrush}"
                                            IsHitTestVisible="False" />
                                    <Thumb x:Name="TrimStartHandle" Style="{StaticResource TrimHandle}" />
                                    <Thumb x:Name="TrimEndHandle" Style="{StaticResource TrimHandle}" />
                                </Canvas>
                            </Grid>

                            <!-- Buttons row -->
                            <Grid Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <!-- Transport reads back-to-forward with play in the
                                         middle: 10s, 5s, play, 5s, 10s. -->
                                    <Button x:Name="Back10Button" Style="{StaticResource IconButton}"
                                            Click="OnBack10Click" ToolTip="{loc:Str TipBack10}">
                                        <Grid Width="24" Height="24">
                                            <Path Data="{StaticResource BackRingGeometry}"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="None" />
                                            <Path Data="{StaticResource BackArrowGeometry}"
                                                  Fill="{StaticResource TextPrimaryBrush}"
                                                  Stretch="None" />
                                            <TextBlock Style="{StaticResource SkipCount}" Text="10" />
                                        </Grid>
                                    </Button>

                                    <Button x:Name="Back5Button" Style="{StaticResource IconButton}"
                                            Click="OnBack5Click" ToolTip="{loc:Str TipBack5}">
                                        <Grid Width="24" Height="24">
                                            <Path Data="{StaticResource BackRingGeometry}"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="None" />
                                            <Path Data="{StaticResource BackArrowGeometry}"
                                                  Fill="{StaticResource TextPrimaryBrush}"
                                                  Stretch="None" />
                                            <TextBlock Style="{StaticResource SkipCount}" Text="5" />
                                        </Grid>
                                    </Button>

                                    <Button x:Name="PlayButton" Style="{StaticResource PrimaryIconButton}"
                                            Click="OnPlayPauseClick" ToolTip="{loc:Str TipPlayPause}">
                                        <Grid Width="24" Height="24">
                                            <Path x:Name="PlayIcon"
                                                  Data="{StaticResource PlayGeometry}"
                                                  Fill="{StaticResource TextPrimaryBrush}"
                                                  Stretch="None" />
                                        </Grid>
                                    </Button>

                                    <Button x:Name="Fwd5Button" Style="{StaticResource IconButton}"
                                            Click="OnFwd5Click" ToolTip="{loc:Str TipForward5}">
                                        <Grid Width="24" Height="24">
                                            <Path Data="{StaticResource FwdRingGeometry}"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="None" />
                                            <Path Data="{StaticResource FwdArrowGeometry}"
                                                  Fill="{StaticResource TextPrimaryBrush}"
                                                  Stretch="None" />
                                            <TextBlock Style="{StaticResource SkipCount}" Text="5" />
                                        </Grid>
                                    </Button>

                                    <Button x:Name="Fwd10Button" Style="{StaticResource IconButton}"
                                            Click="OnFwd10Click" ToolTip="{loc:Str TipForward10}">
                                        <Grid Width="24" Height="24">
                                            <Path Data="{StaticResource FwdRingGeometry}"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="None" />
                                            <Path Data="{StaticResource FwdArrowGeometry}"
                                                  Fill="{StaticResource TextPrimaryBrush}"
                                                  Stretch="None" />
                                            <TextBlock Style="{StaticResource SkipCount}" Text="10" />
                                        </Grid>
                                    </Button>

                                    <TextBlock x:Name="TimeLabel"
                                               Style="{StaticResource TimeText}"
                                               Margin="12,0,0,0"
                                               Text="0:00" />
                                    <TextBlock Style="{StaticResource TimeText}"
                                               Margin="6,0,6,0"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Text="/" />
                                    <TextBlock x:Name="DurationLabel"
                                               Style="{StaticResource TimeText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="0:00" />

                                    <!-- Speed sits with the clock rather than in the icon
                                         cluster: it is a fact about time, and the right
                                         hand side is already full. -->
                                    <Button x:Name="SpeedButton"
                                            Style="{StaticResource SpeedPill}"
                                            Margin="14,0,0,0"
                                            Click="OnSpeedClick"
                                            ToolTip="{loc:Str TipSpeed}">
                                        <TextBlock x:Name="SpeedLabel"
                                                   Text="1×"
                                                   Foreground="{StaticResource TextTertiaryBrush}" />
                                    </Button>
                                </StackPanel>

                                <!-- Centre title, windowed mode shows it here -->
                                <!-- File name, with the rest of the folder either side of it -->
                                <StackPanel x:Name="FolderNav"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <Button x:Name="PrevFileButton"
                                            Style="{StaticResource NavButton}"
                                            Click="OnPreviousFileClick"
                                            Visibility="Collapsed">
                                        <Grid Width="24" Height="24">
                                            <Path Data="{StaticResource ChevronLeftGeometry}"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="None" />
                                        </Grid>
                                    </Button>

                                    <TextBlock x:Name="CentreTitle"
                                               Style="{StaticResource TitleText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="Normal"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               MaxWidth="320"
                                               Margin="4,0,4,0" />

                                    <Button x:Name="NextFileButton"
                                            Style="{StaticResource NavButton}"
                                            Click="OnNextFileClick"
                                            Visibility="Collapsed">
                                        <Grid Width="24" Height="24">
                                            <Path Data="{StaticResource ChevronRightGeometry}"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="None" />
                                        </Grid>
                                    </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="VolumeButton" Style="{StaticResource IconButton}"
                                            Click="OnMuteClick" ToolTip="{loc:Str TipMute}">
                                        <Grid Width="24" Height="24">
                                            <Path x:Name="SpeakerIcon"
                                                  Data="{StaticResource SpeakerGeometry}"
                                                  Fill="{StaticResource TextPrimaryBrush}"
                                                  Stretch="None" />
                                            <Path x:Name="WavesIcon"
                                                  Data="{StaticResource WavesHighGeometry}"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="None" />
                                        </Grid>
                                    </Button>

                                    <Slider x:Name="Volume"
                                            Style="{StaticResource VolumeSlider}"
                                            Width="86"
                                            Margin="2,0,10,0"
                                            VerticalAlignment="Center" />

                                    <Button x:Name="TrimButton" Style="{StaticResource IconButton}"
                                            Click="OnTrimClick" ToolTip="{loc:Str TipTrim}">
                                        <Grid Width="24" Height="24">
                                            <Path x:Name="TrimIcon"
                                                  Data="{StaticResource TrimGeometry}"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="None" />
                                        </Grid>
                                    </Button>

                                    <Button x:Name="OpenButton" Style="{StaticResource IconButton}"
                                            Click="OnOpenClick" ToolTip="{loc:Str TipOpen}">
                                        <Grid Width="24" Height="24">
                                            <Path Data="{StaticResource OpenGeometry}"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeLineJoin="Round"
                                                  Stretch="None" />
                                        </Grid>
                                    </Button>

                                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}"
                                            Click="OnSettingsClick" ToolTip="{loc:Str TipSettings}">
                                        <Grid Width="24" Height="24">
                                            <Path Data="{StaticResource SettingsGeometry}"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="None" />
                                        </Grid>
                                    </Button>

                                    <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}"
                                            Click="OnFullscreenClick" ToolTip="{loc:Str TipFullscreen}">
                                        <Grid Width="24" Height="24">
                                            <Path x:Name="FullscreenIcon"
                                                  Data="{StaticResource EnterFullGeometry}"
                                                  Stroke="{StaticResource TextPrimaryBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="None" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </vlc:VideoView>
    </Grid>
</Window>
